// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// User model representing registered student or educator accounts.
/// Uses soft-delete (deletedAt) to preserve solver run history upon account deactivation.
model User {
  id            String         @id @default(uuid()) @map("id") @db.Uuid
  email         String         @unique @map("email") @db.VarChar(255)
  passwordHash  String         @map("password_hash") @db.VarChar(255)
  emailVerified Boolean        @default(false) @map("email_verified")
  lastLoginAt   DateTime?      @map("last_login_at") @db.Timestamptz(6)
  deletedAt     DateTime?      @map("deleted_at") @db.Timestamptz(6)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  solverRuns     SolverRun[]
  refreshTokens  RefreshToken[]
  aiExplanations AiExplanation[]

  @@index([deletedAt])
  @@map("users")
}

/// RefreshToken stores hashed refresh tokens server-side for revocation and rotation.
model RefreshToken {
  id        String    @id @default(uuid()) @map("id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// SolverRun stores the deterministic input and output of a numerical computation.
/// Supports both authenticated users and anonymous solves (userId is nullable).
model SolverRun {
  id             String          @id @default(uuid()) @map("id") @db.Uuid
  userId         String?         @map("user_id") @db.Uuid
  method         String          @map("method") @db.VarChar(100)
  inputPayload   Json            @map("input_payload")
  outputPayload  Json            @map("output_payload")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  aiExplanations AiExplanation[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([method])
  @@map("solver_runs")
}

/// AiExplanation caches or persists LLM pedagogical explanations generated from a SolverRun.
/// Indexed on promptHash to allow instant cache lookups for identical solver outputs.
model AiExplanation {
  id           String     @id @default(uuid()) @map("id") @db.Uuid
  solverRunId  String?    @map("solver_run_id") @db.Uuid
  userId       String?    @map("user_id") @db.Uuid
  focusMode    String     @default("steps") @map("focus_mode") @db.VarChar(50)
  promptHash   String     @map("prompt_hash") @db.VarChar(64)
  responseText String     @map("response_text") @db.Text
  expiresAt    DateTime?  @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  solverRun    SolverRun? @relation(fields: [solverRunId], references: [id], onDelete: Cascade)
  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([promptHash])
  @@index([solverRunId])
  @@index([userId])
  @@index([expiresAt])
  @@map("ai_explanations")
}
